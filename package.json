{
  "name": "desktop-pet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "description": "Windows-first desktop pet life simulator",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:pet && npm run build:manage",
    "build:main": "vite build --config vite.main.config.ts",
    "build:manage": "vite build --config vite.manage.config.ts",
    "build:preload": "npm run build:preload:pet && npm run build:preload:management && npm run build:preload:home",
    "build:preload:home": "vite build --config vite.preload.config.ts --mode home",
    "build:preload:management": "vite build --config vite.preload.config.ts --mode management",
    "build:preload:pet": "vite build --config vite.preload.config.ts --mode pet",
    "build:pet": "vite build --config vite.pet.config.ts",
    "dev": "npm run start",
    "postinstall": "install-electron",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^43.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.0"
  }
}
