{
  "name": "desktop-pet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "description": "Windows-first desktop pet life simulator",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:pet && npm run build:manage && npm run build:home && npm run build:commerce && npm run build:settings && npm run build:onboarding && npm run build:characters && npm run build:integrations",
    "build:characters": "vite build --config vite.characters.config.ts",
    "build:integrations": "vite build --config vite.integrations.config.ts",
    "build:commerce": "vite build --config vite.commerce.config.ts",
    "build:home": "vite build --config vite.home.config.ts",
    "build:onboarding": "vite build --config vite.onboarding.config.ts",
    "build:main": "vite build --config vite.main.config.ts",
    "build:manage": "vite build --config vite.manage.config.ts",
    "build:preload": "npm run build:preload:pet && npm run build:preload:management && npm run build:preload:home && npm run build:preload:commerce && npm run build:preload:settings && npm run build:preload:characters && npm run build:preload:integrations",
    "build:preload:characters": "vite build --config vite.preload.config.ts --mode characters",
    "build:preload:integrations": "vite build --config vite.preload.config.ts --mode integrations",
    "build:preload:commerce": "vite build --config vite.preload.config.ts --mode commerce",
    "build:preload:home": "vite build --config vite.preload.config.ts --mode home",
    "build:preload:management": "vite build --config vite.preload.config.ts --mode management",
    "build:preload:pet": "vite build --config vite.preload.config.ts --mode pet",
    "build:preload:settings": "vite build --config vite.preload.config.ts --mode settings",
    "build:pet": "vite build --config vite.pet.config.ts",
    "build:settings": "vite build --config vite.settings.config.ts",
    "dev": "npm run start",
    "postinstall": "install-electron",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yauzl": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "electron": "^43.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.0",
    "yazl": "^3.3.1"
  }
}
